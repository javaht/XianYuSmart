DB_URL=jdbc:sqlite:/app/data/xianyusmart.db
JWT_SECRET=change-me-to-at-least-32-random-bytes
JWT_EXPIRATION_MS=28800000
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap-admin-password
ALLOWED_ORIGINS=http://localhost:12400
TRUST_PROXY=false
